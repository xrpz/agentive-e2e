prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "BLOCKED gh-pr-merge: agents do not merge PRs: tier 2 is merged by a human and tier 0/1 auto-merge is enabled only by the gate job. NEXT: leave the merge to the human or the agentive-review-gate job",
    match = [["gh", "pr", "merge"]],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "BLOCKED reset-hard: discards uncommitted work. NEXT: ask the human, or commit or stash the work first",
    match = [["git", "reset", "--hard"]],
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "prompt",
    justification = "BLOCKED reset-hard: discards uncommitted work. NEXT: ask the human, or commit or stash the work first",
    match = [["git", "checkout", "--", "."]],
)

prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "prompt",
    justification = "BLOCKED reset-hard: discards uncommitted work. NEXT: ask the human, or commit or stash the work first",
    match = [["git", "restore", "."]],
)

prefix_rule(
    pattern = ["git", "stash", "drop"],
    decision = "prompt",
    justification = "BLOCKED reset-hard: discards uncommitted work. NEXT: ask the human, or commit or stash the work first",
    match = [["git", "stash", "drop"]],
)

prefix_rule(
    pattern = ["git", "stash", "clear"],
    decision = "prompt",
    justification = "BLOCKED reset-hard: discards uncommitted work. NEXT: ask the human, or commit or stash the work first",
    match = [["git", "stash", "clear"]],
)

prefix_rule(
    pattern = ["git", "push", "--delete"],
    decision = "prompt",
    justification = "BLOCKED push-delete: deletes or rewrites remote refs. NEXT: ask the human before deleting remote branches",
    match = [["git", "push", "--delete"]],
)

prefix_rule(
    pattern = ["git", "push", "-d"],
    decision = "prompt",
    justification = "BLOCKED push-delete: deletes or rewrites remote refs. NEXT: ask the human before deleting remote branches",
    match = [["git", "push", "-d"]],
)

prefix_rule(
    pattern = ["git", "push", "--mirror"],
    decision = "prompt",
    justification = "BLOCKED push-delete: deletes or rewrites remote refs. NEXT: ask the human before deleting remote branches",
    match = [["git", "push", "--mirror"]],
)

prefix_rule(
    pattern = ["git", "push", "--prune"],
    decision = "prompt",
    justification = "BLOCKED push-delete: deletes or rewrites remote refs. NEXT: ask the human before deleting remote branches",
    match = [["git", "push", "--prune"]],
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "BLOCKED branch-delete: force-deletes a local branch. NEXT: ask the human, or use git branch -d (merged branches only)",
    match = [["git", "branch", "-D"]],
)

prefix_rule(
    pattern = ["git", "branch", "--delete", "--force"],
    decision = "prompt",
    justification = "BLOCKED branch-delete: force-deletes a local branch. NEXT: ask the human, or use git branch -d (merged branches only)",
    match = [["git", "branch", "--delete", "--force"]],
)

prefix_rule(
    pattern = ["git", "branch", "-d", "-f"],
    decision = "prompt",
    justification = "BLOCKED branch-delete: force-deletes a local branch. NEXT: ask the human, or use git branch -d (merged branches only)",
    match = [["git", "branch", "-d", "-f"]],
)
