    decision = "forbidden",
    justification = "BLOCKED infra-change: infrastructure change (infra changes are the infra team's job). NEXT: write the change as code in a PR (terraform plan / kubectl diff / helm template are allowed)",
    match = [["terraform", "apply"]],
)

